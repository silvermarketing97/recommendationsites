---
layout: base.njk
isHome: true
bodyClass: is-home
permalink: /
---
{#- The home page is built from drag-and-drop sections edited in /admin → Home page (src/_data/home.json) -#}
{%- for b in home.sections -%}
  {%- if b.type == "faq" and b.items and b.items.length -%}
<script type="application/ld+json">{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [{% for f in b.items %}{"@type": "Question", "name": {{ f.q | jsonify | safe }}, "acceptedAnswer": {"@type": "Answer", "text": {{ f.a | jsonify | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]
}</script>
  {%- endif -%}
{%- endfor -%}
{% set inArticle = false %}
{% for b in home.sections %}{% include "partials/block.njk" %}{% endfor %}
