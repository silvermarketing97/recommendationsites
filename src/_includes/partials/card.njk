<article class="card">
  <a class="card__img" href="{{ post.url }}" tabindex="-1" aria-hidden="true">
    {% if post.data.image %}<img src="{{ post.data.image | imgSize(640) }}" alt="" loading="lazy" decoding="async" width="640" height="400">{% endif %}
    <span class="chip chip--{{ post.data.category }}">{{ post.data.category | categoryName(categories) }}</span>
  </a>
  <div class="card__body">
    <h3 class="card__title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
    <p class="card__desc">{{ post.data.description }}</p>
    <p class="card__meta"><time datetime="{{ post.date | isoDate }}">{{ post.date | niceDate }}</time> · {{ post.content | readingTime }} min read</p>
  </div>
</article>
