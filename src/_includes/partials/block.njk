{#- Renders one drag-and-drop block. Expects `b` (the block) and `inArticle` (true inside articles). -#}
{%- set ctaUrl = b.buttonUrl or b.url or site.swagbucksUrl -%}
{%- set isRef = (ctaUrl == site.swagbucksUrl) -%}

{%- if b.type == "hero" -%}
<section class="hero">
  <div class="wrap hero__in{% if not b.showBonusCard %} hero__in--solo{% endif %}">
    <div class="hero__copy">
      {% if b.eyebrow %}<p class="eyebrow">{{ b.eyebrow }}</p>{% endif %}
      <h1>{{ b.title }}{% if b.highlight %} <span class="hl">{{ b.highlight }}</span>{% endif %}</h1>
      {% if b.text %}<p class="hero__lead">{{ b.text }}</p>{% endif %}
      <div class="hero__btns">
        {% if b.buttonText %}<a class="btn btn--gold btn--lg" href="{{ ctaUrl }}"{% if isRef %} target="_blank" rel="sponsored noopener" data-cta="hero"{% endif %}>{{ b.buttonText }}</a>{% endif %}
        {% if b.secondaryText %}<a class="btn btn--ghost btn--lg" href="{{ b.secondaryUrl or '/blog/' }}">{{ b.secondaryText }}</a>{% endif %}
      </div>
      {% if b.showFlags %}<ul class="hero__flags" aria-label="Countries we cover"><li>🇺🇸 US</li><li>🇬🇧 UK</li><li>🇨🇦 Canada</li><li>🇦🇺 Australia</li><li>🇮🇪 Ireland</li></ul>{% endif %}
    </div>
    {% if b.showBonusCard %}
    <div class="hero__art" aria-hidden="true">
      <div class="bonus-card">
        <div class="bonus-card__top"><span class="dot"></span><span class="dot"></span><span class="dot"></span></div>
        <p class="bonus-card__label">Welcome bonus</p>
        <p class="bonus-card__amount">{{ site.swagbucksBonus }}</p>
        <p class="bonus-card__sub">when you join Swagbucks with our link</p>
        <ul class="bonus-card__list">
          <li><span>📝</span> Paid surveys <b>+SB</b></li>
          <li><span>🛒</span> Cashback shopping <b>+SB</b></li>
          <li><span>🎁</span> Redeem: PayPal &amp; gift cards</li>
        </ul>
      </div>
      <div class="float float--1">💸 Survey complete <b>+150 SB</b></div>
      <div class="float float--2">✅ Reward redeemed</div>
    </div>
    {% endif %}
  </div>
</section>

{%- elif b.type == "featured" -%}
<section class="section" id="start">
  <div class="wrap">
    <div class="section__head"><h2 class="section__title">{{ b.title or "Start here" }}</h2>{% if b.subtitle %}<p class="section__sub">{{ b.subtitle }}</p>{% endif %}</div>
    {%- set featured = collections.posts | featuredFirst | limit(3) -%}
    <div class="grid grid--feature">
      {% for post in featured %}
        {% if loop.first %}
        <article class="card card--big">
          <a class="card__img" href="{{ post.url }}" tabindex="-1" aria-hidden="true">
            {% if post.data.image %}<img src="{{ post.data.image | imgSize(1000) }}" alt="" width="1000" height="625" decoding="async">{% endif %}
            <span class="chip chip--{{ post.data.category }}">{{ post.data.category | categoryName(categories) }}</span>
          </a>
          <div class="card__body">
            <h3 class="card__title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
            <p class="card__desc">{{ post.data.description }}</p>
            <p class="card__meta">{{ post.date | niceDate }} · {{ post.content | readingTime }} min read</p>
          </div>
        </article>
        <div class="stack">
        {% else %}{% include "partials/card.njk" %}{% endif %}
      {% endfor %}
        </div>
    </div>
  </div>
</section>

{%- elif b.type == "spotlight" -%}
<section class="section section--dark">
  <div class="wrap spotlight{% if not b.image %} spotlight--solo{% endif %}">
    <div>
      {% if b.eyebrow %}<p class="eyebrow eyebrow--light">{{ b.eyebrow }}</p>{% endif %}
      <h2>{{ b.title }}</h2>
      {% if b.text %}<div class="spotlight__text">{{ b.text | md | safe }}</div>{% endif %}
      {% if b.bullets and b.bullets.length %}<ul class="ticks">{% for t in b.bullets %}<li>{{ t | mdInline | safe }}</li>{% endfor %}</ul>{% endif %}
      <div class="hero__btns">
        {% if b.buttonText %}<a class="btn btn--gold btn--lg" href="{{ ctaUrl }}"{% if isRef %} target="_blank" rel="sponsored noopener" data-cta="spotlight"{% endif %}>{{ b.buttonText }}</a>{% endif %}
        {% if b.secondaryText %}<a class="btn btn--ghost-light btn--lg" href="{{ b.secondaryUrl }}">{{ b.secondaryText }}</a>{% endif %}
      </div>
      {% if isRef %}<p class="fine">{{ site.bonusNote }}</p>{% endif %}
    </div>
    {% if b.image %}<img class="spotlight__img" src="{{ b.image | imgSize(900) }}" alt="{{ b.imageAlt }}" loading="lazy">{% endif %}
  </div>
</section>

{%- elif b.type == "topics" -%}
<section class="section">
  <div class="wrap">
    <div class="section__head"><h2 class="section__title">{{ b.title or "Browse by topic" }}</h2></div>
    <div class="topics">
      {% for c in categories %}
      <a class="topic topic--{{ c.slug }}" href="/category/{{ c.slug }}/">
        <img src="/assets/img/icon-{{ c.icon }}.svg" alt="" width="44" height="44">
        <span class="topic__name">{{ c.name }}</span>
        <span class="topic__desc">{{ c.description }}</span>
        {% set n = (collections.posts | byCategory(c.slug)).length %}<span class="topic__count">{{ n }} {{ "guide" if n == 1 else "guides" }}</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

{%- elif b.type == "latest" -%}
<section class="section section--soft">
  <div class="wrap">
    <div class="section__head"><h2 class="section__title">{{ b.title or "Latest guides" }}</h2><a class="link-more" href="/blog/">See all &rarr;</a></div>
    {% set list = (collections.posts | byCategory(b.category)) if b.category else collections.posts %}
    <div class="grid grid--3">{% for post in list | limit(b.count or 9) %}{% include "partials/card.njk" %}{% endfor %}</div>
  </div>
</section>

{%- elif b.type == "faq" -%}
{% if inArticle %}
<section class="faq"><h2 id="{{ (b.title or 'faq') | slugify }}">{{ b.title or "Frequently asked questions" }}</h2>
  {% for f in b.items %}<details{% if loop.first %} open{% endif %}><summary>{{ f.q }}</summary><p>{{ f.a }}</p></details>{% endfor %}
</section>
{% else %}
<section class="section">
  <div class="wrap wrap--narrow">
    <h2 class="section__title center">{{ b.title or "Quick answers" }}</h2>
    <div class="faq">{% for f in b.items %}<details{% if loop.first %} open{% endif %}><summary>{{ f.q }}</summary><p>{{ f.a }}</p></details>{% endfor %}</div>
  </div>
</section>
{% endif %}

{%- elif b.type == "text" -%}
{% if inArticle %}
{% if b.title %}<h2 id="{{ b.title | slugify }}">{{ b.title }}</h2>{% endif %}
{{ b.body | md | safe }}
{% else %}
<section class="section section--{{ b.background or 'white' }}">
  <div class="wrap {% if b.width != 'wide' %}wrap--narrow{% endif %}">
    {% if b.title %}<h2 class="section__title{% if b.align == 'center' %} center{% endif %}">{{ b.title }}</h2>{% endif %}
    <div class="prose{% if b.align == 'center' %} center{% endif %}">{{ b.body | md | safe }}</div>
  </div>
</section>
{% endif %}

{%- elif b.type == "callout" -%}
<div class="{{ b.style or 'tip' }}">{{ b.body | md | safe }}</div>

{%- elif b.type == "image" -%}
{% if not inArticle %}<section class="section section--tight"><div class="wrap {% if b.width != 'wide' %}wrap--narrow{% endif %}">{% endif %}
<figure class="photo photo--free">
  {% if b.link %}<a href="{{ b.link }}">{% endif %}<img src="{{ b.src | imgSize(1400) }}" alt="{{ b.alt }}" loading="lazy" decoding="async">{% if b.link %}</a>{% endif %}
  {% if b.caption or b.credit %}<figcaption>{{ b.caption }}{% if b.credit %}{% if b.caption %} · {% endif %}Photo: {% if b.creditUrl %}<a href="{{ b.creditUrl }}" target="_blank" rel="noopener">{{ b.credit }}</a>{% else %}{{ b.credit }}{% endif %}{% endif %}</figcaption>{% endif %}
</figure>
{% if not inArticle %}</div></section>{% endif %}

{%- elif b.type == "video" -%}
{% if not inArticle %}<section class="section section--tight"><div class="wrap wrap--narrow">{% endif %}
{% youtube b.id, b.title %}
{% if not inArticle %}</div></section>{% endif %}

{%- elif b.type == "swagbucks" -%}
{% if not inArticle %}<section class="section section--tight"><div class="wrap wrap--narrow">{% endif %}
{% swagbucks b.headline %}
{% if not inArticle %}</div></section>{% endif %}

{%- elif b.type == "cta" -%}
{% if not inArticle %}<section class="section section--tight"><div class="wrap wrap--narrow">{% endif %}
<aside class="cta-box cta-box--plain">
  <div class="cta-box__body">
    {% if b.title %}<p class="cta-box__title">{{ b.title }}</p>{% endif %}
    {% if b.text %}<p class="cta-box__text">{{ b.text }}</p>{% endif %}
    <a class="btn btn--gold" href="{{ ctaUrl }}"{% if isRef or b.newTab %} target="_blank" rel="{{ 'sponsored noopener' if isRef else 'noopener' }}"{% endif %}{% if isRef %} data-cta="block"{% endif %}>{{ b.buttonText or "Learn more" }}</a>
  </div>
</aside>
{% if not inArticle %}</div></section>{% endif %}

{%- elif b.type == "html" -%}
{% if b.code %}
{% if not inArticle and b.width != 'raw' %}<section class="section section--tight"><div class="wrap {% if b.width != 'wide' %}wrap--narrow{% endif %}">{% endif %}
<div class="widget">{{ b.code | safe }}</div>
{% if not inArticle and b.width != 'raw' %}</div></section>{% endif %}
{% endif %}

{%- elif b.type == "ad" -%}
{%- set slotCode = b.code -%}
{% if slotCode %}
{% if not inArticle %}<div class="wrap">{% endif %}
{{ { "enabled": true, "format": b.format, "mobile": b.mobile != false, "code": slotCode } | adSlot(ads.label) | safe }}
{% if not inArticle %}</div>{% endif %}
{% endif %}

{%- elif b.type == "spacer" -%}
<div style="height:{{ b.size or 40 }}px" aria-hidden="true"></div>
{%- endif -%}
