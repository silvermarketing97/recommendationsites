---
layout: base.njk
bodyClass: is-post
---
{%- set catName = category | categoryName(categories) -%}
{%- set postUrl = page.url | absUrl(site.url) -%}

<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "headline": title,
      "description": description,
      "image": [image | imgSize(1200)] if image else [],
      "datePublished": page.date | isoDate,
      "dateModified": (updated or page.date) | isoDate,
      "author": {"@type": "Organization", "name": site.author, "url": site.url + "/about/"},
      "publisher": {"@id": site.url + "/#org"},
      "mainEntityOfPage": postUrl,
      "inLanguage": "en"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Home", "item": site.url + "/"},
        {"@type": "ListItem", "position": 2, "name": catName, "item": site.url + "/category/" + category + "/"},
        {"@type": "ListItem", "position": 3, "name": title, "item": postUrl}
      ]
    }
  ]
} | jsonify | safe }}</script>
{% if faq and faq.length %}
<script type="application/ld+json">{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [{% for f in faq %}{"@type": "Question", "name": {{ f.q | jsonify | safe }}, "acceptedAnswer": {"@type": "Answer", "text": {{ f.a | jsonify | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]
}</script>
{% endif %}

<article class="post">
  <header class="post__head">
    <div class="wrap wrap--narrow">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> <span>/</span> <a href="/category/{{ category }}/">{{ catName }}</a></nav>
      <a class="chip chip--{{ category }}" href="/category/{{ category }}/">{{ catName }}</a>
      <h1>{{ title }}</h1>
      <p class="post__lead">{{ description }}</p>
      <p class="post__meta">
        By <a href="/about/">{{ site.author }}</a> ·
        <time datetime="{{ page.date | isoDate }}">{{ page.date | niceDate }}</time>
        {% if updated %} · Updated <time datetime="{{ updated | isoDate }}">{{ updated | niceDate }}</time>{% endif %}
        · {{ content | readingTime }} min read
      </p>
    </div>
  </header>

  {% if image %}
  <figure class="post__hero wrap">
    <img src="{{ image | imgSize(1400) }}" alt="{{ imageAlt or title }}" width="1400" height="788" fetchpriority="high">
    {% if imageCredit %}<figcaption>Photo: {% if imageCreditUrl %}<a href="{{ imageCreditUrl }}?utm_source=recommendationsites&utm_medium=referral" target="_blank" rel="noopener">{{ imageCredit }}</a>{% else %}{{ imageCredit }}{% endif %} on Unsplash</figcaption>{% endif %}
  </figure>
  {% endif %}

      {#- Article body: drag-and-drop blocks if present, otherwise the simple text editor -#}
      {%- set bodyHtml -%}
        {%- if blocks and blocks.length -%}
          {%- set inArticle = true -%}
          {%- if content | striptags | trim -%}{{ content | safe }}{%- endif -%}
          {%- for b in blocks -%}{% include "partials/block.njk" %}{%- endfor -%}
        {%- else -%}
          {{ content | safe }}
        {%- endif -%}
      {%- endset -%}
  <div class="wrap post__layout">
    {%- set tocItems = bodyHtml | toc -%}
    <aside class="post__side">
      {% if tocItems.length > 2 %}
      <nav class="toc" aria-label="Table of contents">
        <p class="toc__h">In this guide</p>
        <ol>{% for t in tocItems %}<li><a href="#{{ t.id }}">{{ t.text }}</a></li>{% endfor %}</ol>
      </nav>
      {% endif %}
      <div class="side-cta">
        <p class="side-cta__big">{{ site.swagbucksBonus }}</p>
        <p>Welcome bonus when you join Swagbucks through our link.</p>
        <a class="btn btn--gold btn--block" href="{{ site.swagbucksUrl }}" target="_blank" rel="sponsored noopener" data-cta="sidebar">Join free</a>
      </div>
      {{ ads.sidebar | adSlot(ads.label) | safe }}
      {{ ads.widgets | widgetsAt("sidebar") | safe }}
    </aside>

    <div class="post__body">
      <p class="disclosure"><strong>Disclosure:</strong> This article contains referral links. If you sign up through them we may earn a commission at no cost to you. <a href="/affiliate-disclosure/">How we make money</a>.</p>

      {{ ads.articleTop | adSlot(ads.label) | safe }}
      {{ ads.widgets | widgetsAt("articleTop") | safe }}


      <div class="prose">
        {{ bodyHtml | injectAds(ads) | safe }}
      </div>

      {% if videos and videos.length %}
      <section class="prose">
        <h2 id="watch">Watch: video guides</h2>
        {% for v in videos %}
        <figure class="video">
          <button class="video__btn" data-yt="{{ v.id }}" aria-label="Play video: {{ v.title }}" style="background-image:url('https://i.ytimg.com/vi/{{ v.id }}/hqdefault.jpg')"><span class="video__play" aria-hidden="true"></span></button>
          <figcaption>&#9654; {{ v.title }}{% if v.channel %} — {{ v.channel }}{% endif %}</figcaption>
        </figure>
        {% endfor %}
      </section>
      {% endif %}

      {% if faq and faq.length %}
      <section class="faq prose">
        <h2 id="faq">Frequently asked questions</h2>
        {% for f in faq %}
        <details{% if loop.first %} open{% endif %}><summary>{{ f.q }}</summary><p>{{ f.a }}</p></details>
        {% endfor %}
      </section>
      {% endif %}

      {{ ads.articleEnd | adSlot(ads.label) | safe }}
      {{ ads.widgets | widgetsAt("articleEnd") | safe }}

      <aside class="cta-box cta-box--end" aria-label="Swagbucks offer">
        <div class="cta-box__badge">{{ site.swagbucksBonus }}<small>bonus</small></div>
        <div class="cta-box__body">
          <p class="cta-box__title">Ready to start earning?</p>
          <p class="cta-box__text">Create your free Swagbucks account through our link and get a {{ site.swagbucksBonus }} welcome bonus. Take surveys, earn cashback and redeem for PayPal cash or gift cards.</p>
          <a class="btn btn--gold" href="{{ site.swagbucksUrl }}" target="_blank" rel="sponsored noopener" data-cta="post-end">Claim my {{ site.swagbucksBonus }} bonus &rarr;</a>
          <p class="cta-box__fine">{{ site.bonusNote }}</p>
        </div>
      </aside>

      <div class="author">
        <img src="/assets/img/logo.svg" alt="" width="56" height="56">
        <div>
          <p class="author__name">{{ site.author }}</p>
          <p>We test earning apps and side hustles and write plain-English guides for readers in the US, UK, Canada, Australia and Ireland. No hype, no fake income claims. <a href="/about/">More about us</a>.</p>
        </div>
      </div>
    </div>
  </div>

  {%- set rel = collections.posts | related(page, category, 3) -%}
  {% if rel.length %}
  <section class="section section--soft">
    <div class="wrap">
      <h2 class="section__title">Keep reading</h2>
      <div class="grid grid--3">{% for post in rel %}{% include "partials/card.njk" %}{% endfor %}</div>
    </div>
  </section>
  {% endif %}
</article>
